# pk-seqam plus libfaketime on the server process only, so that the clock can be stepped while it runs:
#   echo -2s > /tmp/ft    (the file is read at every clock call)
FROM pk-seqam
RUN apt-get update && apt-get install -y --no-install-recommends faketime && rm -rf /var/lib/apt/lists/*
COPY entrypoint-ft.sh /entrypoint-ft.sh
ENTRYPOINT ["/entrypoint-ft.sh"]
CMD ["postgres"]
