# pgcopydb, built from source at a pinned commit.
#
# Default pin: 4c5a3b8a7472c645e9d6247d315c7d6677c938cc, on main (2026-10-27): it
# includes PR #1064 ("replicate DDL over logical decoding as a typed message"),
# PR #1069 ("flush the apply pipeline after every COMMIT", which fixed an apply
# stall but cost one round trip to the target per transaction) and PR #1070,
# which batches the syncs again. 84bce26, the commit this post first ran on, is
# #1069 without #1070.
#
# PGCOPYDB_PATCH names a patch file in this directory to apply on top of the pin;
# pgcopydb-failover-slot.patch makes the slot a failover slot on Postgres 17+.
#
# Usage:
#   docker build --build-arg PGVERSION=17 -t pgcopydb:demo \
#     -f Dockerfile.pgcopydb .

ARG PGVERSION=17
FROM postgres:${PGVERSION} AS build

ARG PGVERSION
ARG PGCOPYDB_COMMIT=4c5a3b8a7472c645e9d6247d315c7d6677c938cc
ARG PGCOPYDB_REF=main
ARG PGCOPYDB_PATCH=

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential git ca-certificates \
      postgresql-server-dev-${PGVERSION} \
      libpq-dev libssl-dev libicu-dev liblz4-dev libzstd-dev \
      libncurses-dev libedit-dev libselinux1-dev libxml2-dev libxslt1-dev \
      libgc-dev libkrb5-dev libnuma-dev libpam0g-dev libreadline-dev \
      zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/pgcopydb
RUN git init -q \
 && git fetch -q https://github.com/dimitri/pgcopydb.git ${PGCOPYDB_REF} \
 && git checkout -q ${PGCOPYDB_COMMIT}

COPY pgcopydb-failover-slot.patch /tmp/
RUN if [ -n "${PGCOPYDB_PATCH}" ]; then git apply "/tmp/${PGCOPYDB_PATCH}"; fi

RUN make -s clean && make -s install -j"$(nproc)" BINDIR=/usr/local/bin

# ---------------------------------------------------------------------------
# run — official postgres image (for psql/libpq) plus the pgcopydb binary
# and the runtime (non -dev) shared libraries it links against
# ---------------------------------------------------------------------------
FROM postgres:${PGVERSION} AS run

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libgc1 libkrb5-3 libnuma1 libpam0g \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/bin/pgcopydb /usr/local/bin/pgcopydb

ENTRYPOINT ["pgcopydb"]
