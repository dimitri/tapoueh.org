# postgres:<PGVERSION> plus the PGDG pglogical package. The official image
# already has the PGDG apt repository configured.
ARG PGVERSION=18
FROM postgres:${PGVERSION}

ARG PGVERSION
RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-${PGVERSION}-pglogical \
 && rm -rf /var/lib/apt/lists/*
