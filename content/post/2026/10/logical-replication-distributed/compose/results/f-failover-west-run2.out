== two regions, each a pg_auto_failover group: the primary of us-west is killed ==
   us-east primary: us-east-a, us-west primary: us-west-a
-- slots on each primary, and what its standbys hold
   us-east-a: sub_us_west_from_us_east|logical|t
   us-east-a: synchronized_standby_slots = pgautofailover_standby_2,pgautofailover_standby_3
   us-west-a: sub_us_east_from_us_west|logical|t
   us-west-a: synchronized_standby_slots = pgautofailover_standby_2,pgautofailover_standby_3
