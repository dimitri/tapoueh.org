  select e.oid, extname, extnamespace::regnamespace, extrelocatable,
         array_length(e.extconfig, 1) as count,
         extconfig.n,
         extconfig.extconfig,
         format('%I', n.nspname) as nspname,
         format('%I', c.relname) as relname,
         extcondition[extconfig.n],
