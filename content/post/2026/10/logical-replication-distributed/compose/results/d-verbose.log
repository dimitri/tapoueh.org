  JOIN pg_roles auth ON auth.oid = i.relowner
  LEFT JOIN pg_depend d
         ON d.classid = 'pg_class'::regclass
        AND d.objid = i.oid
        AND d.refclassid = 'pg_constraint'::regclass
        AND d.deptype = 'i'
  LEFT JOIN pg_constraint c ON c.oid = d.refobjid,
