select oid, extname, extnamespace, extrelocatable,
       count,
       row_number() over (partition by oid order by depth) as n,
       extconfig,
       nspname,
       relname,
       extcondition,
       relkind
 from extension_config_data
      left outer join ordered_fk_constraints ofc on extconfig = ofc.relid
;
