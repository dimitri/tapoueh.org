-- settings on the primary
   wal_level = logical
   synchronized_standby_slots = pgautofailover_standby_2,pgautofailover_standby_3
   synchronous_standby_names = ANY 1 (pgautofailover_standby_2, pgautofailover_standby_3)
   synchronous_commit = on
-- settings on the standbys
   us-east-b: sync_replication_slots = on, hot_standby_feedback = on, dbname in primary_conninfo: t
   us-east-c: sync_replication_slots = on, hot_standby_feedback = on, dbname in primary_conninfo: t
