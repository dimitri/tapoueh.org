### 1. pg_create_subscription alone
migrator@new> CREATE SUBSCRIPTION s_scratch CONNECTION 'host=old dbname=scratch user=repl password=repl' PUBLICATION p_scratch
ERROR:  permission denied for database scratch

### 2. + CREATE on the database
migrator@new> CREATE SUBSCRIPTION s_scratch CONNECTION 'host=old dbname=scratch user=repl' PUBLICATION p_scratch
ERROR:  password is required
DETAIL:  Non-superusers must provide a password in the connection string.
migrator@new> CREATE SUBSCRIPTION s_scratch CONNECTION 'host=old dbname=scratch user=repl password=repl' PUBLICATION p_scratch
NOTICE:  created replication slot "s_scratch" on publisher
CREATE SUBSCRIPTION

### state after 6s: tablesync cannot write into a table migrator does not own
new> SELECT srrelid::regclass, srsubstate FROM pg_subscription_rel
 srrelid | srsubstate 
---------+------------
 t       | d
(1 row)

new> SELECT subname, subowner::regrole, subrunasowner, subpasswordrequired FROM pg_subscription
  subname  | subowner | subrunasowner | subpasswordrequired 
-----------+----------+---------------+---------------------
 s_scratch | migrator | f             | t
(1 row)

new> SELECT count(*) FROM t
 count 
-------
     0
(1 row)


### 3. give migrator the table (ownership) -> the sync completes
new> SELECT srrelid::regclass, srsubstate FROM pg_subscription_rel
 srrelid | srsubstate 
---------+------------
 t       | r
(1 row)

new> SELECT * FROM t ORDER BY 1
 id |  v   
----+------
  1 | row1
  2 | row2
  3 | row3
(3 rows)


### cleanup of the scratch subscription (drops the slot on old)
migrator@new> DROP SUBSCRIPTION s_scratch
NOTICE:  dropped replication slot "s_scratch" on publisher
DROP SUBSCRIPTION
old> SELECT slot_name FROM pg_replication_slots
 slot_name 
-----------
(0 rows)

