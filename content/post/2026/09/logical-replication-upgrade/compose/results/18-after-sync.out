### sequences: old (live) vs new
old> SELECT sequencename, last_value FROM pg_sequences ORDER BY 1
    sequencename     | last_value 
---------------------+------------
 customers_id_seq    |      51270
 invoice_no          |     602269
 measurements_id_seq |     301270
 orders_id_seq       |     601270
(4 rows)

new> SELECT sequencename, last_value FROM pg_sequences ORDER BY 1
    sequencename     | last_value 
---------------------+------------
 customers_id_seq    |           
 invoice_no          |           
 measurements_id_seq |           
 orders_id_seq       |           
(4 rows)

### consequence: an INSERT on new would reuse ids already replicated
BEGIN
ERROR:  duplicate key value violates unique constraint "orders_pkey"
DETAIL:  Key (id)=(1) already exists.
ROLLBACK

### materialized view: created WITH NO DATA by the schema dump, and replication never fills it
new> SELECT count(*) FROM sales_by_day
ERROR:  materialized view "sales_by_day" has not been populated
HINT:  Use the REFRESH MATERIALIZED VIEW command.
new> REFRESH MATERIALIZED VIEW sales_by_day
REFRESH MATERIALIZED VIEW
new> SELECT count(*) AS days FROM sales_by_day
 days 
------
    1
(1 row)


### large objects: the documents row was replicated, the object behind body_oid was not
old> SELECT id, title, length(lo_get(body_oid)) AS lo_bytes FROM documents
 id | title  | lo_bytes 
----+--------+----------
  1 | manual |    60000
(1 row)

new> SELECT id, title, body_oid IS NOT NULL AS has_oid FROM documents
 id | title  | has_oid 
----+--------+---------
  1 | manual | t
(1 row)

new> SELECT count(*) AS large_objects FROM pg_largeobject_metadata
 large_objects 
---------------
             0
(1 row)

new> SELECT length(lo_get(body_oid)) FROM documents
ERROR:  large object 16461 does not exist

### the ordinary data is there, generated column recomputed on the subscriber
old> SELECT count(*) AS seed_orders, sum(vat) AS vat FROM orders WHERE client_seq < 0
 seed_orders |     vat     
-------------+-------------
      600000 | 30060000.00
(1 row)

new> SELECT count(*) AS seed_orders, sum(vat) AS vat FROM orders WHERE client_seq < 0
 seed_orders |     vat     
-------------+-------------
      600000 | 30060000.00
(1 row)

new> SELECT count(*) AS partition_rows_2026 FROM measurements_2026
 partition_rows_2026 
---------------------
              301284
(1 row)

