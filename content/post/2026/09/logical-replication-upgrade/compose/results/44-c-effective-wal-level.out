pg19c> SHOW wal_level
 wal_level 
-----------
 replica
(1 row)

pg19c> SHOW effective_wal_level
 effective_wal_level 
---------------------
 replica
(1 row)

pg19c> SELECT name, context FROM pg_settings WHERE name IN ('wal_level', 'effective_wal_level') ORDER BY 1
        name         |  context   
---------------------+------------
 effective_wal_level | internal
 wal_level           | postmaster
(2 rows)


### a publication needs nothing special
pg19c> CREATE PUBLICATION p FOR ALL TABLES
CREATE PUBLICATION
pg19c> SHOW effective_wal_level
 effective_wal_level 
---------------------
 replica
(1 row)


### creating the first logical slot switches logical decoding on, no restart
pg19c> SELECT slot_name FROM pg_create_logical_replication_slot('s1', 'pgoutput')
 slot_name 
-----------
 s1
(1 row)

pg19c> SHOW effective_wal_level
 effective_wal_level 
---------------------
 logical
(1 row)

pg19c> SHOW wal_level
 wal_level 
-----------
 replica
(1 row)

pg19c> SELECT slot_name, slot_type FROM pg_replication_slots
 slot_name | slot_type 
-----------+-----------
 s1        | logical
(1 row)


### dropping the last logical slot switches it off again
pg19c> SELECT pg_drop_replication_slot('s1')
 pg_drop_replication_slot 
--------------------------
 
(1 row)

pg19c> SHOW effective_wal_level
 effective_wal_level 
---------------------
 replica
(1 row)


### the same through CREATE SUBSCRIPTION from another server
pg19b> CREATE SUBSCRIPTION s_wal CONNECTION 'host=pg19c dbname=app user=postgres password=postgres' PUBLICATION p
NOTICE:  created replication slot "s_wal" on publisher
CREATE SUBSCRIPTION
pg19b> SELECT count(*) AS rows_copied FROM t
 rows_copied 
-------------
           2
(1 row)

pg19c> SHOW effective_wal_level
 effective_wal_level 
---------------------
 logical
(1 row)

pg19b> DROP SUBSCRIPTION s_wal
NOTICE:  dropped replication slot "s_wal" on publisher
DROP SUBSCRIPTION
pg19c> SHOW effective_wal_level
 effective_wal_level 
---------------------
 replica
(1 row)

