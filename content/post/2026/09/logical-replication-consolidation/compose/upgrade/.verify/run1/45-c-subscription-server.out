pg19b> CREATE SUBSCRIPTION s_bad SERVER nosuch PUBLICATION p
ERROR:  server "nosuch" does not exist
pg19b> SELECT fdwname, fdwhandler::regproc, fdwconnection::regproc FROM pg_foreign_data_wrapper
 fdwname | fdwhandler | fdwconnection 
---------+------------+---------------
(0 rows)

pg19b> CREATE EXTENSION postgres_fdw
CREATE EXTENSION
pg19b> SELECT fdwname, fdwconnection::regproc FROM pg_foreign_data_wrapper
   fdwname    |      fdwconnection      
--------------+-------------------------
 postgres_fdw | postgres_fdw_connection
(1 row)

pg19b> CREATE SERVER pub_srv FOREIGN DATA WRAPPER postgres_fdw OPTIONS (host 'pg19a', port '5432', dbname 'srv')
CREATE SERVER
pg19b> CREATE USER MAPPING FOR postgres SERVER pub_srv OPTIONS (user 'postgres', password 'postgres')
CREATE USER MAPPING
pg19b> CREATE SUBSCRIPTION s_srv SERVER pub_srv PUBLICATION p
NOTICE:  created replication slot "s_srv" on publisher
CREATE SUBSCRIPTION
pg19b> SELECT * FROM t ORDER BY 1
 id 
----
  1
  2
(2 rows)

pg19b> SELECT s.subname, f.srvname AS server, s.subconninfo IS NULL AS no_conninfo FROM pg_subscription s JOIN pg_foreign_server f ON f.oid = s.subserver
 subname | server  | no_conninfo 
---------+---------+-------------
 s_srv   | pub_srv | t
(1 row)


### the connection parameters now live in the SERVER: changing them redirects the subscription
pg19b> ALTER SERVER pub_srv OPTIONS (SET host 'nonexistent-host')
ALTER SERVER
pg19b> ALTER SUBSCRIPTION s_srv DISABLE
ALTER SUBSCRIPTION
pg19b> ALTER SUBSCRIPTION s_srv ENABLE
ALTER SUBSCRIPTION
pg19b> SELECT pid IS NOT NULL AS apply_running FROM pg_stat_subscription WHERE subname = 's_srv'
 apply_running 
---------------
 f
(1 row)

pg19b> ALTER SERVER pub_srv OPTIONS (SET host 'pg19a')
ALTER SERVER
pg19b> SELECT pid IS NOT NULL AS apply_running FROM pg_stat_subscription WHERE subname = 's_srv'
 apply_running 
---------------
 t
(1 row)

