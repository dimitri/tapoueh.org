### 0. the schema dump of step 13 already created a FOR ALL TABLES publication on new
new> SELECT pubname, puballtables FROM pg_publication
 pubname | puballtables 
---------+--------------
 app_pub | t
(1 row)


### 1. the forward subscription must stop forwarding what it did not originate
new> SELECT subname, suborigin FROM pg_subscription
 subname | suborigin 
---------+-----------
 app_sub | any
(1 row)

new> ALTER SUBSCRIPTION app_sub SET (origin = none)
ALTER SUBSCRIPTION
new> SELECT subname, suborigin FROM pg_subscription
 subname | suborigin 
---------+-----------
 app_sub | none
(1 row)


### 2. reverse subscription on old: no initial copy, only changes made locally on new
old> CREATE SUBSCRIPTION app_rev CONNECTION 'host=new dbname=app user=repl password=repl' PUBLICATION app_pub WITH (copy_data = false, origin = none)
NOTICE:  created replication slot "app_rev" on publisher
CREATE SUBSCRIPTION
old> SELECT subname, suborigin, subenabled FROM pg_subscription
 subname | suborigin | subenabled 
---------+-----------+------------
 app_rev | none      | t
(1 row)

old> SELECT srrelid::regclass AS tbl, srsubstate FROM pg_subscription_rel ORDER BY srrelid::regclass::text
        tbl         | srsubstate 
--------------------+------------
 audit_log          | r
 counters           | r
 customers          | r
 cutover_markers    | r
 documents          | r
 late_table         | r
 measurements_2026  | r
 measurements_other | r
 orders             | r
(9 rows)


### 3. probe both directions, and prove nothing bounces back
new> INSERT INTO audit_log (event, payload) VALUES ('probe-from-new', 'x')
INSERT 0 1
old> INSERT INTO audit_log (event, payload) VALUES ('probe-from-old', 'x')
INSERT 0 1
old> SELECT event, count(*) FROM audit_log WHERE event LIKE 'probe-%' GROUP BY 1 ORDER BY 1
     event      | count 
----------------+-------
 probe-from-new |     1
 probe-from-old |     1
(2 rows)

new> SELECT event, count(*) FROM audit_log WHERE event LIKE 'probe-%' GROUP BY 1 ORDER BY 1
     event      | count 
----------------+-------
 probe-from-new |     1
 probe-from-old |     1
(2 rows)

new> DELETE FROM audit_log WHERE event LIKE 'probe-%'
DELETE 2
old> SELECT count(*) AS probes_left FROM audit_log WHERE event LIKE 'probe-%'
 probes_left 
-------------
           0
(1 row)

new> SELECT count(*) AS probes_left FROM audit_log WHERE event LIKE 'probe-%'
 probes_left 
-------------
           0
(1 row)

old> SELECT slot_name, active FROM pg_replication_slots ORDER BY 1
 slot_name | active 
-----------+--------
 app_sub   | t
(1 row)

new> SELECT slot_name, active FROM pg_replication_slots ORDER BY 1
 slot_name | active 
-----------+--------
 app_rev   | t
(1 row)


### 4. pitfall: reverse subscription WITH copy_data = true (scratch database)
old> CREATE SUBSCRIPTION s_rev_bad CONNECTION 'host=new dbname=scratch user=repl password=repl' PUBLICATION p_new_scratch WITH (copy_data = true, origin = none)
NOTICE:  created replication slot "s_rev_bad" on publisher
CREATE SUBSCRIPTION
old> SELECT srrelid::regclass, srsubstate FROM pg_subscription_rel
 srrelid | srsubstate 
---------+------------
 t       | d
(1 row)

old> DROP SUBSCRIPTION s_rev_bad
NOTICE:  dropped replication slot "pg_16496_sync_16479_7688042808173522982" on publisher
NOTICE:  dropped replication slot "s_rev_bad" on publisher
DROP SUBSCRIPTION
