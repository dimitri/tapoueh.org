-- @service: shop
-- Step 2a: the real apps. shop owns schema "shop": distinct schema names at the
-- source are what let the three apps land side by side in one warehouse.
create schema shop;
CREATE SCHEMA
create table shop.customers (
  id int primary key, account_id int not null, name text not null,
  email text, phone text, country text, tenant text not null
);
CREATE TABLE
create table shop.orders (
  id serial primary key, customer_id int not null references shop.customers(id),
  amount numeric(10,2) not null, status text not null, tenant text not null
);
CREATE TABLE
insert into shop.customers values
  (1, 1, 'Alice', 'alice@example.com', '+33 1 00 00 00 01', 'FR', 'eu'),
  (2, 1, 'Bob',   'bob@example.com',   '+33 1 00 00 00 02', 'FR', 'eu'),
  (3, 2, 'Carol', 'carol@example.com', '+1 555 0100',       'US', 'us'),
  (4, 3, 'Dan',   'dan@example.com',   '+49 30 000004',     'DE', 'eu');
INSERT 0 4
insert into shop.orders (customer_id, amount, status, tenant) values
  (1, 100.00, 'paid', 'eu'), (2, 50.00, 'paid', 'eu'),
  (3, 75.00, 'paid', 'us'),  (4, 20.00, 'new', 'eu');
INSERT 0 4
-- plain publication first (no PII tables yet: those come in the filtering step)
create publication pub_shop for table shop.orders;
CREATE PUBLICATION
create role repl replication login password 'repl';
ERROR:  role "repl" already exists
grant pg_read_all_data to repl;
NOTICE:  role "repl" has already been granted membership in role "pg_read_all_data" by role "postgres"
GRANT ROLE
