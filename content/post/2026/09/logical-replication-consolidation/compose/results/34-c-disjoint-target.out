-- @service: warehouse
-- @nosync
-- No trigger at all: the column DEFAULT is evaluated by the apply worker (and by the
-- initial copy) for the column the publisher does not send. session_user is the
-- subscription owner, one role per source.
create table public.customers (
  source text not null default regexp_replace(session_user, '^sub_', ''),
  id int primary key, name text, city text);
CREATE TABLE
alter table public.customers owner to wh_owner;
ALTER TABLE
set role sub_shop;
SET
create subscription sub_c_shop connection 'host=shop dbname=shop user=repl password=repl' publication pub_c;
NOTICE:  created replication slot "sub_c_shop" on publisher
CREATE SUBSCRIPTION
set role sub_crm;
SET
create subscription sub_c_crm connection 'host=crm dbname=crm user=repl password=repl' publication pub_c;
NOTICE:  created replication slot "sub_c_crm" on publisher
CREATE SUBSCRIPTION
reset role;
RESET
