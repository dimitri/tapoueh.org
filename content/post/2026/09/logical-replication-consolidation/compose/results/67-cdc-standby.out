### 7. CDC from the standby: a change on shop travels shop -> warehouse primary -> standby -> slot
BEGIN
table shop.orders: INSERT: id[integer]:40009 customer_id[integer]:1 amount[numeric]:77.00 status[text]:'via-standby' tenant[text]:'eu'
COMMIT
