-- Step 4b. The new node (empty server): schema, reference subscription (initial copy of its
-- slice only), local events for its customers, publication of the events.
CREATE TABLE plans (plan_id int PRIMARY KEY, name text NOT NULL);
CREATE TABLE
CREATE TABLE prices (plan_id int, meter text, unit_price numeric(10,4) NOT NULL, PRIMARY KEY (plan_id, meter));
CREATE TABLE
CREATE TABLE customers (
  customer_id int GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  name text NOT NULL, worker_id int NOT NULL, plan_id int NOT NULL
);
CREATE TABLE
CREATE SUBSCRIPTION sub_ref_w4
  CONNECTION 'host=hub dbname=app user=postgres' PUBLICATION ref_w4;
