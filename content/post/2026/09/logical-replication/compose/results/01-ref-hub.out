  (3, 'api_calls', 0.0050), (3, 'storage_gb', 0.2500);
INSERT 0 6
-- nine customers, three per worker
INSERT INTO customers (name, worker_id, plan_id, billing_notes)
SELECT 'customer-' || n, (n - 1) / 3 + 1, (n - 1) % 3 + 1, 'net-30, secret discount ' || n
FROM generate_series(1, 9) n;
INSERT 0 9
CREATE PUBLICATION ref_all FOR TABLE plans, prices, customers;
CREATE PUBLICATION
SELECT pubname, tablename FROM pg_publication_tables ORDER BY 1, 2;
 pubname | tablename 
---------+-----------
 ref_all | customers
 ref_all | plans
 ref_all | prices
