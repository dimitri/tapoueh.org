-- @service: hub
-- Step 4d. Recovery from the duplicate-key stall of step 2c with ALTER SUBSCRIPTION ... SKIP.
-- The stall is still there (the apply worker of sub_naive_w2 has been retrying since):
SELECT subname, apply_error_count >= 2 AS still_failing FROM pg_stat_subscription_stats WHERE subname = 'sub_naive_w2';
   subname    | still_failing 
--------------+---------------
 sub_naive_w2 | t
(1 row)

-- The LSN to skip is the "finished at" LSN of the CONTEXT line of the error in the server log.
SELECT lr.log_last_lsn('CONTEXT.*usage_naive') AS skip_lsn \gset
SELECT 'ALTER SUBSCRIPTION sub_naive_w2 SKIP (lsn = ''' || lr.norm(:'skip_lsn') || ''')' AS about_to_run;
                    about_to_run                    
----------------------------------------------------
 ALTER SUBSCRIPTION sub_naive_w2 SKIP (lsn = 'X/X')
(1 row)

ALTER SUBSCRIPTION sub_naive_w2 SKIP (lsn = :'skip_lsn');
ALTER SUBSCRIPTION
SELECT lr.wait_for($$SELECT subskiplsn = '0/0' FROM pg_subscription WHERE subname = 'sub_naive_w2'$$);
 wait_for 
----------
 t
(1 row)

SELECT lr.wait_for($$SELECT pid IS NOT NULL FROM pg_stat_subscription WHERE subname = 'sub_naive_w2' AND worker_type = 'apply'$$);
 wait_for 
----------
 t
(1 row)

SELECT lr.norm(l) AS log_line FROM lr.log_lines('skipping transaction') l;
                                log_line                                
------------------------------------------------------------------------
 [] LOG:  logical replication starts skipping transaction at LSN X/X
 [] LOG:  logical replication completed skipping transaction at LSN X/X
(2 rows)

-- The whole transaction was dropped: worker2's 3 events never reach the hub. This is data
-- divergence that has to be repaired by hand (or the row fixed at the source).
SELECT count(*) AS rows_on_hub FROM usage_naive;
 rows_on_hub 
-------------
           3
(1 row)

SELECT event_id, customer_id FROM dblink(lr.conn('worker2'), 'SELECT event_id, customer_id FROM usage_naive ORDER BY 1')
  AS t(event_id bigint, customer_id int);
 event_id | customer_id 
----------+-------------
        1 |           4
        2 |           4
        3 |           4
(3 rows)

-- The subscription is healthy again: the next event of worker2 (event_id 4) arrives.
SELECT lr.on('worker2', 'INSERT INTO usage_naive (customer_id, qty) VALUES (4, 42)');
     on     
------------
 INSERT 0 1
(1 row)

SELECT lr.wait_for($$SELECT count(*) = 4 FROM usage_naive$$);
 wait_for 
----------
 t
(1 row)

SELECT event_id, customer_id, qty FROM usage_naive ORDER BY 1;
 event_id | customer_id | qty 
----------+-------------+-----
        1 |           1 |   1
        2 |           1 |   2
        3 |           1 |   3
        4 |           4 |  42
(4 rows)

